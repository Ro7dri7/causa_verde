<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detalle_pro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F8CB"
    android:clipToOutline="true">

    <!-- SECCIÓN INFERIOR FIJA (Cantidad y Botón Agregar) -->
    <LinearLayout
        android:id="@+id/bottom_bar_fija"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E0F8CB"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:elevation="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- ID tv_total_label agregado aquí -->
            <TextView
                android:id="@+id/tv_total_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Total (1 paquetes)"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="S/15.50"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- Selector de Cantidad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_paso"
                android:backgroundTint="#F5FCEE"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/btn_restar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/tv_cantidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/btn_sumar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:paddingStart="16dp" />
            </LinearLayout>

            <!-- Botón Agregar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_agregar_carrito"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="2"
                android:layout_marginStart="16dp"
                android:text="Agregar"
                android:textColor="#2A4222"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#F2BA11"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENIDO SCROLLABLE (Todo lo que está encima de la barra fija) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_bar_fija"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- IMAGEN DEL PRODUCTO (Fondo) -->
            <ImageView
                android:id="@+id/img_portada_producto"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scaleType="centerCrop"
                android:background="#D1E2BC" />

            <!-- BOTÓN FLOTANTE REGRESAR -->
            <FrameLayout
                android:id="@+id/btn_volver_detalle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_paso"
                android:backgroundTint="#BCE49A"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/retroceder"
                    app:tint="#1F361F" />
            </FrameLayout>

            <!-- TARJETA CON BORDES REDONDEADOS QUE SE SUPERPONE A LA IMAGEN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="230dp"
                app:cardBackgroundColor="#E0F8CB"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <!-- Cabecera de la Tienda -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/logo_inicio"
                            android:background="@drawable/bg_pill_paso"
                            android:backgroundTint="#FFFFFF"
                            android:padding="4dp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Starbucks"
                                android:textColor="#1F361F"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ 5.0 • 📍 2.5 km • Carabayllo • 🕒 12:00 pm - 9:00 pm"
                                android:textColor="#1F361F"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Línea separadora amarilla -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#F2BA11"
                        android:layout_marginVertical="16dp" />

                    <!-- Detalles del Producto -->
                    <TextView
                        android:id="@+id/tv_titulo_producto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pack Sorpresa Dulce y Salado"
                        android:textColor="#1A1A1A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 disponibles"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Este pack está pensado para los que disfrutan de lo dulce y lo casero.\nPuede incluir alfajores artesanales(marplatense, de maicena), budines (de almendras, zanahoria y naranja, chocolate y café, limón y amapola), o cookies variadas como chocolate, limon y jengibre."
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/15.50"
                            android:textColor="#1A1A1A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/tv_precio_tachado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/37.00"
                            android:textColor="#888888"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Línea separadora amarilla -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#F2BA11"
                        android:layout_marginVertical="16dp" />

                    <!-- Sección: Otros Paquetes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otros paquetes"
                        android:textColor="#1A1A1A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Lista de otros paquetes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Ítem Otro Paquete 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#D1E2BC"
                                android:layout_marginEnd="16dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pack Horneados..."
                                    android:textColor="#1A1A1A"
                                    android:textSize="14sp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/15.50"
                                        android:textStyle="bold"
                                        android:textColor="#1A1A1A"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/37.00"
                                        android:textColor="#888888"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/icon_mas" />
                        </LinearLayout>

                        <!-- Ítem Otro Paquete 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#D1E2BC"
                                android:layout_marginEnd="16dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pack Horneados..."
                                    android:textColor="#1A1A1A"
                                    android:textSize="14sp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/15.50"
                                        android:textStyle="bold"
                                        android:textColor="#1A1A1A"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/37.00"
                                        android:textColor="#888888"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/icon_mas" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>