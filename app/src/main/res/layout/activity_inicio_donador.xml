<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vista_donad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F8CB"
    android:clipToOutline="true">

    <!-- 1. HEADER SUPERIOR FIJO -->
    <RelativeLayout
        android:id="@+id/header_superior_donador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#E0F8CB"
        android:elevation="6dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/logo_inicio"
                android:layout_marginEnd="8dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación"
                    android:textSize="10sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/tv_ubicacion_texto_donador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carabayllo, Lima"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F361F" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/btn_notificaciones_donador"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icon_notificacion"
                android:layout_marginEnd="12dp" />
            <ImageView
                android:id="@+id/btn_perfil_donador"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_user_profile" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. BARRA DE NAVEGACIÓN INFERIOR (4 opciones con IDs) -->
    <LinearLayout
        android:id="@+id/bottom_nav_donador"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#F5FCEE"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/btn_nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_home"
                app:tint="#385B35" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="11sp"
                android:textColor="#385B35"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aquí se actualizó el ID y el src a icon_inventario -->
        <LinearLayout
            android:id="@+id/btn_nav_inventario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_inventario"
                app:tint="#666666" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventario"
                android:textSize="11sp"
                android:textColor="#666666" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_nav_pedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_pedido"
                app:tint="#666666" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedidos"
                android:textSize="11sp"
                android:textColor="#666666" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_nav_metricas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_estadistica"
                app:tint="#666666" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Métricas"
                android:textSize="11sp"
                android:textColor="#666666" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. CONTENIDO PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_superior_donador"
        android:layout_above="@id/bottom_nav_donador"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Etiqueta Abierto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_paso"
                android:backgroundTint="#F2BA11"
                android:text="🟢 Abierto hasta 22:00 pm"
                android:textColor="#1F361F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Saludo -->
            <TextView
                android:id="@+id/tv_saludo_donador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Hola, Supermercado!"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_fecha_actual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Hoy, 19 de Octubre"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Tarjetas de Métricas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <!-- Ofertas Activas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#D6EED0"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OFERTAS ACTIVAS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1F361F" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginEnd="4dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="en catálogo"
                                android:textSize="12sp"
                                android:textColor="#1A1A1A"
                                android:layout_marginBottom="6dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_paso"
                            android:backgroundTint="#C3E1B9"
                            android:text="3 por vencer hoy"
                            android:textSize="11sp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_marginTop="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Impacto de Hoy -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#D6EED0"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IMPACTO DE HOY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1F361F" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:layout_marginEnd="4dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="raciones"
                                android:textSize="12sp"
                                android:textColor="#1A1A1A"
                                android:layout_marginBottom="6dp" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ingresos  + S/45.00"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#385B35"
                            android:layout_marginTop="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18.4 kg evitados"
                            android:textSize="11sp"
                            android:textColor="#1A1A1A"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Acciones Rápidas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acciones Rápidas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publica excedentes en menos de 1 minuto"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <!-- Botón: + Producto -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_crear_producto"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#D6EED0"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_paso"
                            android:backgroundTint="#C3E1B9"
                            android:text="+"
                            android:textSize="24sp"
                            android:gravity="center"
                            android:textColor="#1A1A1A"
                            android:layout_marginBottom="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Producto"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Excedente individual"
                            android:textSize="11sp"
                            android:textColor="#555555" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón: + Armar Pack -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_armar_pack"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#8CB82A"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/icon_pedido"
                            app:tint="#1A1A1A"
                            android:layout_marginBottom="12dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Armar Pack"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mix sorpresa variado"
                            android:textSize="11sp"
                            android:textColor="#1F361F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Ofertas por Vencer -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Ofertas por vencer"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ver todas"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#7A5C00" />
            </RelativeLayout>

            <!-- Lista de Ofertas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#D6EED0"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="#BCE49A"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pan Blanco Bimbo 550 g"
                            android:textStyle="bold"
                            android:textColor="#1A1A1A"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕐 Expira: hoy 18:00 hrs"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginVertical="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="S/15.50"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@drawable/bg_pill_paso"
                                android:backgroundTint="#C3E1B9"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:paddingHorizontal="6dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3 un."
                                    android:textSize="12sp"
                                    android:paddingHorizontal="8dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+"
                                    android:textStyle="bold"
                                    android:textColor="#8CB82A"
                                    android:textSize="16sp"
                                    android:paddingHorizontal="6dp" />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Alerta Informativa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_paso"
                android:backgroundTint="#D6EED0"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_paso"
                    android:backgroundTint="#98FF98"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Los compradores cercanos recibirán una alerta automática en tiempo real al ajustar tus cantidades."
                    android:textSize="11sp"
                    android:textColor="#1A1A1A" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>